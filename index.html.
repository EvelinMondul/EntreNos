document.querySelectorAll('#mfilters .chip').forEach(c=>{ c.addEventListener('click',()=>{ document.querySelectorAll('#mfilters .chip').forEach(x=>x.classList.remove('on')); c.classList.add('on'); mFilter=c.dataset.mc; renderMyths(); }); });

const chatlog=document.getElementById('chatlog'), chatInput=document.getElementById('chatInput'), chatSend=document.getElementById('chatSend'), suggestBox=document.getElementById('suggests');
function bubble(text,who){ const b=document.createElement('div'); b.className='bub '+who; b.textContent=text; chatlog.appendChild(b); chatlog.scrollTop=chatlog.scrollHeight; return b; }
function normaliza(s){ return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9ñ ]/g," "); }
function mejorRespuesta(texto){ const t=normaliza(texto); const palabras=t.split(/\s+/).filter(w=>w.length>2); let best=null,bestScore=0;
  QUESTIONS.forEach(q=>{ const campo=normaliza(q.pregunta+" "+q.palabras); let score=0; palabras.forEach(w=>{ if(campo.includes(w)) score++; }); if(score>bestScore){ bestScore=score; best=q; } });
  return bestScore>=1?best.respuesta:null; }
function renderSuggests(){ suggestBox.innerHTML=''; QUESTIONS.slice(0,6).forEach(q=>{ const b=document.createElement('button'); b.textContent=q.pregunta; b.addEventListener('click',()=>preguntar(q.pregunta)); suggestBox.appendChild(b); }); }
function preguntar(texto){ const q=(texto||chatInput.value).trim(); if(!q) return; chatInput.value=''; bubble(q,'me');
  const resp=mejorRespuesta(q); setTimeout(()=>{ if(resp) bubble(resp,'bot'); else bubble("Mmm, esa no la tengo todavía. Puedes tocar una de las preguntas de abajo, o contarle tu duda a tu profe o tu familia, que te ayudarán con gusto.","bot"); },250); }
chatSend.addEventListener('click',()=>preguntar());
chatInput.addEventListener('keydown',e=>{ if(e.key==='Enter') preguntar(); });

document.getElementById('resetBtn').addEventListener('click',async()=>{ await store.set('name',''); gate.classList.remove('hide'); nameInput.value=''; nameInput.focus(); });

(async function init(){
  await initDevice(); await loadContent(); await loadUserData();
  render(); renderRoutines(); renderMyths(); renderSuggests();
  bubble("¡Hola! Soy Semi. Toca una pregunta de abajo o escríbeme tu duda sobre comer, moverte, crecer o cómo te sientes.","bot");
  document.getElementById('dbflag').textContent = USE_SB ? "● Conectado a la base de datos" : "○ Modo de prueba (sin base de datos aún)";
  const name=await store.get('name'); if(name){ greet(name); gate.classList.add('hide'); } else { setTimeout(()=>nameInput.focus(),400); }
})();
</script>
